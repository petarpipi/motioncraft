{
  "name": "motioncraft",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5184 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4184 --strictPort",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "assets": "node scripts/generate-field.mjs",
    "posters": "node scripts/render-posters.mjs",
    "screenshots": "node scripts/capture.mjs",
    "performance": "node scripts/performance.mjs",
    "format": "prettier --write src tests scripts *.ts *.json *.md index.html",
    "format:check": "prettier --check src tests scripts *.ts *.json *.md index.html"
  },
  "dependencies": {
    "@fontsource/space-grotesk": "^5.2.10",
    "gsap": "^3.14.2",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.9.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "prettier": "3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
